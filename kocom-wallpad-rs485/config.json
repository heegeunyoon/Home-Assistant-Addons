{
  "name": "Kocom Wallpad with RS485",
  "version": "2026.11.09.4",
  "slug": "kocom_py",
  "description": "Kocom Wallpad for Home Assistant",
  "arch": [
    "armhf",
    "armv7",
    "aarch64",
    "amd64",
    "i386"
  ],
  "url": "https://github.com/heegeunyoon/Home-Assistant-Addons",
  "startup": "application",
  "boot": "auto",
  "uart": true,
  "map": [
    "share:rw"
  ],
  "services": [
    "mqtt:want"
  ],
  "options": {
    "type": "serial",
    "serial_port": "/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0",
    "socket_server": "",
    "socket_port": 8899,
    "mqtt_server": "",
    "mqtt_port": 1883,
    "mqtt_allow_anonymous": false,
    "mqtt_username": "",
    "mqtt_password": "",
    "devices": [
      {
        "type": "light",
        "room": "livingroom"
      },
      {
        "type": "light",
        "room": "livingroom"
      },
      {
        "type": "light",
        "room": "room1"
      },
      {
        "type": "light",
        "room": "room1"
      },
      {
        "type": "light",
        "room": "room2"
      },
      {
        "type": "light",
        "room": "room3"
      },
      {
        "type": "thermo",
        "room": "livingroom"
      },
      {
        "type": "thermo",
        "room": "room1"
      },
      {
        "type": "thermo",
        "room": "room2"
      },
      {
        "type": "thermo",
        "room": "room3"
      },
      {
        "type": "aircon",
        "room": "livingroom"
      },
      {
        "type": "aircon",
        "room": "room1"
      },
      {
        "type": "aircon",
        "room": "room2"
      },
      {
        "type": "aircon",
        "room": "room3"
      },
      {
        "type": "outlet",
        "room": "livingroom"
      },
      {
        "type": "outlet",
        "room": "livingroom"
      },
      {
        "type": "outlet",
        "room": "room1"
      },
      {
        "type": "outlet",
        "room": "room1"
      },
      {
        "type": "outlet",
        "room": "room2"
      },
      {
        "type": "outlet",
        "room": "room3"
      },
      {
        "type": "outlet",
        "room": "kitchen"
      },
      {
        "type": "outlet",
        "room": "kitchen"
      },
      {
        "type": "gas",
        "room": "livingroom"
      },
      {
        "type": "elevator"
      },
      {
        "type": "motion",
        "room": "livingroom"
      }
    ],
    "elevator_type": "rs485",
    "rs485_floor": 7,
    "init_temp": 23,
    "away_mode": "entrance",
    "away_gas_room": "livingroom",
    "log_recv_hex": false,
    "log_mqtt_publish": false
  },
  "schema": {
    "type": "list(serial|socket)",
    "serial_port": "str?",
    "socket_server": "str?",
    "socket_port": "int?",
    "mqtt_server": "str?",
    "mqtt_port": "int",
    "mqtt_allow_anonymous": "bool",
    "mqtt_username": "str?",
    "mqtt_password": "password?",
    "devices": [
      {
        "type": "list(light|outlet|thermo|aircon|gas|elevator|motion|airquality)",
        "room": "list(livingroom|room1|room2|room3|kitchen)?"
      }
    ],
    "elevator_type": "list(rs485|tcpip)",
    "rs485_floor": "int",
    "init_temp": "int",
    "away_mode": "list(entrance|macro)",
    "away_gas_room": "str",
    "log_recv_hex": "bool",
    "log_mqtt_publish": "bool"
  }
}
